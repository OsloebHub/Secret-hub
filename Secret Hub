    Name = "Auto Restart Match",
    Default = false,
    Callback = function(Value) autoRestartActive = Value end
})

task.spawn(function()
    while true do
        if autoFarmActive then
            local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
            local mapLobby = workspace:FindFirstChild("Lobby") or workspace:FindFirstChild("Elevators")
            
            local matchFinished = false
            local gui = player:FindFirstChild("PlayerGui")
            if gui and (gui:FindFirstChild("VictoryGui") or gui:FindFirstChild("DefeatGui") or gui:FindFirstChild("GameOverGui")) then
                matchFinished = true
            end

            if matchFinished and autoRestartActive then
                local teleportService = game:GetService("TeleportService")
                teleportService:Teleport(game.PlaceId, player)
                task.wait(10)
            end

            if mapLobby then
                unitsSold = false
                local targetPlatform = mapLobby:FindFirstChild(selectedMode) or workspace:FindFirstChild(selectedMode)
                if targetPlatform and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    player.Character.HumanoidRootPart.CFrame = targetPlatform.CFrame + Vector3.new(0, 3, 0)
                end
            else
                if remotes and remotes:FindFirstChild("SkipWave") then remotes.SkipWave:FireServer() end
                
                local matchInfo = workspace:FindFirstChild("MatchInfo") or game:GetService("ReplicatedStorage"):FindFirstChild("MatchInfo")
                local currentWave = matchInfo and matchInfo:FindFirstChild("Wave") and matchInfo.Wave.Value or 1
                local spawnPos = Vector3.new(0, 0, 0)
                
                if currentWave <= 5 then
                    local placeRemote = remotes and remotes:FindFirstChild("PlaceUnit")
                    if placeRemote then
                        local inventory = player:FindFirstChild("Inventory")
                        local starterUnit = "Ninja Cameraman"
                        if inventory then
                            if inventory:FindFirstChild("Ninja Cameraman") then starterUnit = "Ninja Cameraman"
                            elseif inventory:FindFirstChild("Dark Speakerman") then starterUnit = "Dark Speakerman"
                            else starterUnit = "Large Speakerman" end
                        end
                        placeRemote:FireServer(starterUnit, CFrame.new(spawnPos))
                    end
                    
                elseif currentWave >= 6 and not unitsSold then
                    local sellRemote = remotes and remotes:FindFirstChild("SellUnit")
                    if sellRemote then
                        for _, unit in pairs(workspace:GetChildren()) do
                            if unit:FindFirstChild("Owner") and unit.Owner.Value == player.Name then
                                if unit.Name == "Ninja Cameraman" or unit.Name == "Dark Speakerman" or unit.Name == "Large Speakerman" then
                                    sellRemote:FireServer(unit)
                                end
                            end
                        end
                        unitsSold = true
                    end
                    
                elseif currentWave >= 6 then
                    local placeRemote = remotes and remotes:FindFirstChild("PlaceUnit")
                    if placeRemote then
                        placeRemote:FireServer(selectedMainMenuUnit, CFrame.new(spawnPos + Vector3.new(3, 0, 3)))
                    end
                end

                local upgradeRemote = remotes and remotes:FindFirstChild("UpgradeUnit")
                if upgradeRemote then
                    for _, unit in pairs(workspace:GetChildren()) do
                        if unit:FindFirstChild("Owner") and unit.Owner.Value == player.Name then
                            local currentLevel = unit:FindFirstChild("Level") and unit.Level.Value or 1
                            if maxLevels[unit.Name] and currentLevel < maxLevels[unit.Name] then
                                upgradeRemote:FireServer(unit)
                            end
                        end
                    end
                end
            end
        end
        task.wait(1.5)
    end
end)

